# =============================================================================
# Nidan Docker — environment template
# Copy to .env and adjust. Variable names and section order match .env for easy diffing.
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway & TLS (Let's Encrypt via certbot)
# -----------------------------------------------------------------------------
GATEWAY_IMAGE=trigonaltechnology/gateway:latest
GATEWAY_DOMAIN=localhost
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAINS=localhost

# -----------------------------------------------------------------------------
# TLS trust / keystores (optional; FHIR or HTTPS clients)
# -----------------------------------------------------------------------------
SSL_TRUSTSTORE_PATH=
SSL_TRUSTSTORE_PASSWORD=
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# -----------------------------------------------------------------------------
# OpenMRS — MySQL + EMR API (CIS uses DB host for Debezium; REST below)
# -----------------------------------------------------------------------------
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=openmrs
OPENMRS_DB_HOST=openmrs-db
OPENMRS_DB_PORT=3306
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=1GB
OMRS_DEBUG=false

# REST / FHIR identifiers (nidan-cis → OpenMRS)
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
OPENMRS_IDENTIFIER_TYPE_UUID=c0e1d2f3-a4b5-4c6d-9e0f-1a2b3c4d5e6f
OPENMRS_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
OPENMRS_FHIR_EXTENSION_URL=http://fhir.openmrs.org/ext/patient/identifier#location

# orders.order_type_id values (Debezium event mapping; verify: SELECT order_type_id, name FROM order_type)
OPENMRS_ORDER_TYPE_DRUG=2
OPENMRS_ORDER_TYPE_LAB=3
OPENMRS_ORDER_TYPE_RADIOLOGY=11
OPENMRS_ORDER_TYPE_PROCEDURE=4
OPENMRS_ORDER_TYPE_MEDICAL_SUPPLY=5

# -----------------------------------------------------------------------------
# Orthanc — PostgreSQL + DICOM server (HTTP basic for Orthanc UI / CIS)
# -----------------------------------------------------------------------------
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=orthanc
ORTHANC_DB_HOST=orthanc-db
ORTHANC_USERNAME=nidan
ORTHANC_PASSWORD=nidan
ORTHANC_DICOM_UID_ROOT=1.2.840.10008

# -----------------------------------------------------------------------------
# OpenELIS — app + DB + CIS REST client
# -----------------------------------------------------------------------------
OPENELIS_DOMAIN=localhost
OPENELIS_DB_NAME=clinlims
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=clinlims
OPENELIS_DEFAULT_ADMIN_PASSWORD=adminADMIN!
OPENELIS_TZ=UTC

# nidan-cis → OpenELIS-Global REST
OPENELIS_ENABLED=true
OPENELIS_BASE_URL=http://openelis:8080/OpenELIS-Global/rest
OPENELIS_USERNAME=admin
OPENELIS_PASSWORD=adminADMIN!

# -----------------------------------------------------------------------------
# Odoo — PostgreSQL + app + OIS bridge
# -----------------------------------------------------------------------------
ODOO_DB_NAME=nidan
ODOO_DB_USER=nidan
ODOO_DB_PASSWORD=nidan
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_DB=postgres
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_ADMIN_EMAIL=nidan
ODOO_ADMIN_PASSWORD=nidan
ODOO_WEB_BASE_URL=http://localhost:8069
ODOO_WEB_BASE_URL_FREEZE=True

# Extra addons: main compose uses ODOO_ADDONS_PATH; dev.docker-compose.yml uses ODOO_EXTRA_ADDONS_HOST_PATH (same path).
ODOO_ADDONS_PATH=../odoo_19_addons
ODOO_EXTRA_ADDONS_HOST_PATH=../odoo_19_addons

# OIS URL/secret (Odoo module + echoed on nidan-ois). If you change OIS_PORT, update the URL.
NIDAN_OIS_URL=http://nidan-ois:8082
NIDAN_OIS_SECRET=sample

# nidan-ois → Odoo JSON-RPC (database name must match ODOO_DB_NAME)
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
ODOO_POS_ORDER_REF_PREFIX=RAD-
ODOO_POS_DEFAULT_RADIOLOGY_PRODUCT_ID=1

# Shared secrets: keep Odoo and OIS values aligned (NIDAN_OIS_SECRET ↔ Odoo module config).
NIDAN_ODOO_SECRET=your-secret-key
ODOO_NIDAN_SECRET=your-secret-key
OIS_WEBHOOK_SECRET=your-secret-key

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_RELATIVE_PATH=/auth

# -----------------------------------------------------------------------------
# Nidan middleware PostgreSQL (CIS + OIS)
# -----------------------------------------------------------------------------
INTEGRATION_DB_NAME=nidan_integration
INTEGRATION_DB_USER=nidan
INTEGRATION_DB_PASSWORD=nidan
INTEGRATION_DB_HOST=nidan-integration-db
INTEGRATION_DB_PORT=5432

# -----------------------------------------------------------------------------
# Zookeeper & Kafka
# -----------------------------------------------------------------------------
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ZOOKEEPER_CONNECT=nidan-zookeeper:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# -----------------------------------------------------------------------------
# CIS (nidan-cis) — image, ports, feature toggles & integration targets
# Local build: ../nidan-middleware/integration — or set registry images, e.g.
#   NIDAN_CIS_IMAGE=trigonaltechnology/nidan-cis:latest
# -----------------------------------------------------------------------------
NIDAN_CIS_IMAGE=nidan-cis:local
CIS_PORT=8081
CIS_KAFKA_GROUP_ID=nidan-cis
# Optional JVM truststore for HTTPS (regenerate: scripts/create-gateway-truststore.sh)
# CIS_JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/ssl/certs/gateway-truststore.p12 -Djavax.net.ssl.trustStorePassword=gatewayTrust123 -Djdk.internal.httpclient.disableHostnameVerification=true

OPENMRS_ENABLED=true
OPENMRS_BASE_URL=http://openmrs-backend:8080/openmrs
ORTHANC_ENABLED=true
ORTHANC_BASE_URL=http://orthanc:8042
# MWL .wl output; compose must mount ./orthanc/worklists → this path
ORTHANC_WORKLIST_DIR=/var/lib/orthanc/worklists
DICOM_TYPE=orthanc

INTEGRATION_SOURCE_SYSTEM=CIS
INTEGRATION_SKIP_SOURCE_SYSTEMS=OPENMRS
RADIOLOGY_ACCESSION_PREFIX=RAD-
RADIOLOGY_PROCEDURE_CODE_PREFIX=RAD-

# integration.flows.* — false skips that workflow (Kafka consumers still run).
# radiology-mwl: MWL, Orthanc webhook, Orthanc REST (CIS).
# radiology-pos: Odoo POS for radiology (OIS).
# lab-openelis / lab-pos: lab to OpenELIS (CIS) and lab POS (OIS).
# debezium-publish.*: only when DEBEZIUM_ENABLED=true (CIS embedded → Kafka).
INTEGRATION_FLOW_RADIOLOGY_MWL_ENABLED=true
INTEGRATION_FLOW_RADIOLOGY_POS_ENABLED=true
INTEGRATION_FLOW_LAB_OPENELIS_ENABLED=true
INTEGRATION_FLOW_LAB_POS_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_LAB_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_RADIOLOGY_ENABLED=true

DEBEZIUM_ENABLED=true
DEBEZIUM_DB_USER=root
DEBEZIUM_DB_PASSWORD=openmrs
DEBEZIUM_TABLE_INCLUDE_LIST=openmrs.orders,openmrs.person,openmrs.person_name,openmrs.patient_identifier

INTEGRATION_KAFKA_RETRY_ENABLED=true
INTEGRATION_KAFKA_RETRY_ATTEMPTS=5
INTEGRATION_KAFKA_RETRY_INITIAL_DELAY=5s
INTEGRATION_KAFKA_RETRY_MULTIPLIER=2.0
INTEGRATION_KAFKA_RETRY_MAX_DELAY=10m
CIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-cis-retry
CIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.cis.DLT

# -----------------------------------------------------------------------------
# OIS (nidan-ois)
# -----------------------------------------------------------------------------
NIDAN_OIS_IMAGE=nidan-ois:local
OIS_PORT=8082
OIS_KAFKA_GROUP_ID=nidan-ois
ODOO_BASE_URL=http://odoo:8069
SKIP_SOURCE_SYSTEMS_FOR_ODOO=ODOO

OIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-ois-retry
OIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.ois.DLT

# -----------------------------------------------------------------------------
# DHIS2 / Federal HMIS
# -----------------------------------------------------------------------------
DHIS2_APP_PORT=5000
DHIS2_SECRET_KEY=change-me-to-a-long-random-string
DHIS2_DEBUG=false
DHIS2_FLASK_ENV=production
DHIS2_AUTH_PROVIDER=env_file
DHIS2_REPORTER_USERNAME=reporter
DHIS2_REPORTER_PASSWORD=change-me
DHIS2_DB_CONNECT_TIMEOUT=10
DHIS2_DB_DATE_OVERLAP_BUFFER_DAYS=2

DHIS2_DB_NAME=nidan_dhis2
DHIS2_DB_USER=nidan
DHIS2_DB_PASSWORD=reporter
DHIS2_DB_ROOT_PASSWORD=reporter
DHIS2_DB_HOST=nidan-dhis2-db
DHIS2_DB_PORT=3306

FEDERAL_HMIS_URL=https://hmis.gov.np/hmis
FEDERAL_HMIS_USERNAME=hospitalcode
FEDERAL_HMIS_PASSWORD=change-me
FEDERAL_HMIS_SSL_VERIFY=false
FEDERAL_HMIS_ORG_UNIT=

PROVINCIAL_DHIS2_URL=
PROVINCIAL_DHIS2_USERNAME=
PROVINCIAL_DHIS2_PASSWORD=
PROVINCIAL_DHIS2_SSL_VERIFY=true
PROVINCIAL_DHIS2_ORG_UNIT=

# -----------------------------------------------------------------------------
# Superset (seeds use OPENMRS_DB_*, OPENELIS_DB_*, ODOO_DB_* from above)
# -----------------------------------------------------------------------------
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_IMAGE=trigonaltechnology/superset:latest
